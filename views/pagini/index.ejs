<!DOCTYPE html>
<html lang="ro">
<%- include('../fragmente/head') %>

    <body>
        <%- include('../fragmente/header') %>

            <main id="grid-pagina">

                <section id="welcome" class="zona1">
                    <hgroup>
                        <h2>Lumea Digitală la un Click Distanță</h2>
                        <p class="subtitlu">Unde arta întâlnește tehnologia blockchain.</p>
                    </hgroup>
                    <blockquote cite="https://ethereum.org">
                        "NFT-urile oferă artiștilor puterea de a deține controlul asupra propriilor creații."
                    </blockquote>
                    <figure id="hero-img">
                        <img src="/resurse/imagini/banner-mare.jpg" usemap="#zenovex-map" alt="Banner Zenovex">
                        <map name="zenovex-map">
                            <area shape="rect" coords="0,0,400,300" href="#welcome" alt="Acasa">
                        </map>
                        <figcaption>Preview: Colecția "Cybernetic Dreams".</figcaption>
                    </figure>
                </section>

                <section id="statistici" class="zona2">
                    <h2><i class="fas fa-chart-line fa-beat"></i> Top Artiști</h2>
                    <div class="container-tabel">
                        <table>
                            <caption>Volum tranzacționat săptămâna aceasta</caption>
                            <thead>
                                <tr>
                                    <th>Artist</th>
                                    <th>Colecție</th>
                                    <th>Status</th>
                                    <th>Volum</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td rowspan="2"><b>PixelMaster</b></td>
                                    <td>Retro Waves</td>
                                    <td>Trending</td>
                                    <td>15.5 ETH</td>
                                </tr>
                                <tr>
                                    <td>Neon Nights</td>
                                    <td>Stabil</td>
                                    <td>8.2 ETH</td>
                                </tr>
                                <tr>
                                    <td><b>CryptoArtiste</b></td>
                                    <td>Abstract Soul</td>
                                    <td>Top Seller</td>
                                    <td>22.1 ETH</td>
                                </tr>
                                <tr>
                                    <td><b>NeoSculptor</b></td>
                                    <td>Digital Bloom</td>
                                    <td>Rising</td>
                                    <td>11.8 ETH</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3">Total Marketplace:</td>
                                    <td>45.8 ETH</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>

                <section id="evenimente" class="zona3">
                    <h2>Evenimente</h2>
                    <ul>
                        <li><time datetime="2026-03-23 19:00">23 Martie</time> - Lansare "Neo-Tokyo".</li>
                        <li><time datetime="2026-03-28 14:00">28 Martie</time> - Workshop Securitate.</li>
                    </ul>
                </section>

                <section class="zona6">
                    <h2>Anunțuri</h2>
                    <p><strong>ATENȚIE!</strong> Beneficiază de <ins><s>10%</s> 0% comision</ins> acum!</p>
                </section>

                <section class="zona8">
                    <div id="video-ghid">
                        <h2>Tutoriale Video</h2>
                        <div class="taburi-video">
                            <!-- NFT? → video local cu subtitrări -->
                            <a href="#" id="tab-nft" onclick="showLocalVideo(event)">NFT?</a>
                            <!-- Securitate și Playlist → iframe YouTube -->
                            <a href="https://www.youtube.com/embed/hXuK6FxD2bo"
                                onclick="showYoutube(event, this.href)">Securitate</a>
                            <a href="https://www.youtube.com/embed?list=PLASEfdY-tiDrIwtPGSO7dfqeVvVyjf07o"
                                onclick="showYoutube(event, this.href)">Playlist</a>
                        </div>

                        <!-- Video local NFT cu trackuri VTT (vizibil la click pe NFT?) -->
                        <video id="video-local" controls preload="metadata" poster="/resurse/imagini/nft-poster.png"
                            style="display:none; width:85%; max-width:53rem; margin:1.25rem auto; aspect-ratio:16/9; object-fit:cover;">
                            <source src="/resurse/video/ghid-nft.mp4" type="video/mp4">
                            <track kind="subtitles" src="/resurse/video/subtitles-ro.vtt" srclang="ro" label="Română"
                                default>
                            <track kind="subtitles" src="/resurse/video/subtitles-en.vtt" srclang="en" label="English">
                            Browserul tău nu suportă elementul video.
                        </video>

                        <iframe id="iframe-youtube" name="video-player"
                            src="https://www.youtube.com/embed?list=PLASEfdY-tiDrIwtPGSO7dfqeVvVyjf07o" title="YouTube"
                            allowfullscreen></iframe>
                    </div>

                    <hr class="separator-hr">

                    <%- include('../fragmente/galerie', { imaginiGalerie: locals.imaginiGalerie || [], caleGalerie: locals.caleGalerie || '' }) %>

                </section>

                <section class="zona7">
                    <div class="math-container-header">
                        <h3><i class="fas fa-calculator"></i> Calculul Costului</h3>
                        <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                            <mrow>
                                <msub class="m-rezultat">
                                    <mi>C</mi>
                                    <mtext>total</mtext>
                                </msub>
                                <mo class="m-operator">=</mo>
                                <msub class="m-pret">
                                    <mi>P</mi>
                                    <mtext>NFT</mtext>
                                </msub>
                                <mo class="m-operator">+</mo>
                                <mo class="m-paranteza">(</mo>
                                <mi class="m-variabila">G</mi>
                                <mo class="m-operator">&times;</mo>
                                <msub class="m-variabila">
                                    <mi>P</mi>
                                    <mtext>gas</mtext>
                                </msub>
                                <mo class="m-paranteza">)</mo>
                            </mrow>
                        </math>
                    </div>
                    <p class="nota-math"><small>* G reprezintă unitățile de Gas, iar Pgas prețul per unitate.</small></p>
                </section>

                <section class="zona5">
                    <h3>Status Rețea</h3>
                    <p class="reflexie-text" data-text="Gas Price: 15 Gwei">Gas Price: 15 Gwei</p>
                </section>

                <section id="educatie" class="zona4">
                    <h3><i class="fas fa-graduation-cap"></i> Informații Utile</h3>
                    <p>Vrei să înveți mai multe despre NFT-uri? Află tot ce trebuie să știi despre tehnologia din spatele lor.</p>
                    <ul>
                        <li>Ce sunt NFT-urile și cum funcționează</li>
                        <li>Standarde blockchain (ERC-721, ERC-1155)</li>
                        <li>Piețe populare: OpenSea, Rarible, Foundation</li>
                    </ul>
                    <p>
                        <a href="https://en.wikipedia.org/wiki/Non-fungible_token" target="_blank" rel="noopener noreferrer">
                            Citește mai mult pe Wikipedia
                        </a>
                    </p>
                </section>

            </main>

            <%- include('../fragmente/footer') %>

                <script>
                    function showLocalVideo(e) {
                        e.preventDefault();
                        document.getElementById('video-local').style.display = 'block';
                        document.getElementById('iframe-youtube').style.display = 'none';
                    }
                    function showYoutube(e, url) {
                        e.preventDefault();
                        var iframe = document.getElementById('iframe-youtube');
                        var video = document.getElementById('video-local');
                        video.pause();
                        video.style.display = 'none';
                        iframe.src = url;
                        iframe.style.display = 'block';
                    }
                </script>
    </body>

</html>